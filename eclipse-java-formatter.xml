<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Java formatter profile for the Red Hat Java extension in VS Code (Eclipse JDT formatter).
  Settings not listed here fall back to the Eclipse built-in defaults.
  Follows the AmaliTech Coding Standards, Java Edition: 4-space indent, 100-column limit.
-->
<profiles version="23">
    <profile kind="CodeFormatterProfile" name="AmaliTech Java" version="23">

        <!-- Indentation: 4 spaces per level, never tabs; wrapped lines get 8 (2 x 4) -->
        <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
        <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
        <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
        <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="2"/>
        <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="2"/>

        <!-- Line length: wrap code and comments at 100 columns -->
        <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="100"/>
        <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="100"/>
        <setting id="org.eclipse.jdt.core.formatter.comment.count_line_length_from_starting_position" value="true"/>

        <!-- Keep line breaks you made by hand, so readable wrapping is not undone -->
        <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>

        <!-- Wrap long lines where necessary (16 = wrap where necessary) -->
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_method_invocation" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_allocation_expression" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_parameters_in_method_declaration" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_selector_in_method_invocation" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_string_concatenation" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_additive_operator" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_logical_operator" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_conditional_expression" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_binary_expression" value="16"/>

        <!-- Put the operator at the start of the wrapped line, as in the handbook's examples -->
        <setting id="org.eclipse.jdt.core.formatter.wrap_before_string_concatenation" value="true"/>
        <setting id="org.eclipse.jdt.core.formatter.wrap_before_additive_operator" value="true"/>
        <setting id="org.eclipse.jdt.core.formatter.wrap_before_logical_operator" value="true"/>
        <setting id="org.eclipse.jdt.core.formatter.wrap_before_conditional_operator" value="true"/>
        <setting id="org.eclipse.jdt.core.formatter.wrap_before_binary_operator" value="true"/>

        <!-- Vertical spacing: remove any blank line straight after a method's opening brace.
             A negative value means "remove existing blank lines", 0 would only stop adding them. -->
        <setting id="org.eclipse.jdt.core.formatter.number_of_blank_lines_at_beginning_of_method_body" value="-1"/>
        <setting id="org.eclipse.jdt.core.formatter.number_of_empty_lines_to_preserve" value="1"/>

        <!-- Every file ends with a newline -->
        <setting id="org.eclipse.jdt.core.formatter.insert_new_line_at_end_of_file_if_missing" value="insert"/>

    </profile>
</profiles>
